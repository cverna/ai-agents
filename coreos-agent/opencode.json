{
  "$schema": "https://opencode.ai/config.json",
  "model": "google-vertex-anthropic/claude-sonnet-4-6@default",
  "permission": {
    "external_directory": {
      "/tmp/*": "allow"
    },
    "edit": {
      "~/.config/opencode/skills/*": "allow",
      "~/.config/opencode/commands/*": "allow",
      "~/.config/opencode/agents/*": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.config/*": "deny",
      "~/.config/opencode/opencode.json": "deny",
      "~/.config/opencode/AGENTS.md": "deny",
      "~/.config/opencode/skills/*": "allow",
      "~/.config/opencode/commands/*": "allow",
      "~/.config/opencode/agents/*": "allow",
      "/opt/opencode-config/*": "deny"
    },
    "bash": {
      "env": "deny",
      "env *": "deny",
      "printenv": "deny",
      "printenv *": "deny"
    },
    "skill": {
      "*": "allow"
    }
  }
}
