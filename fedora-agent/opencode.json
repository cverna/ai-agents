{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.5-free",
  "update": "disable",
  "mcp": {
    "servers": {
      "gitea-mcp": {
        "type": "local",
        "codemode": false,
        "command": [
          "gitea-mcp",
          "-t", "stdio",
          "-H", "https://forge.fedoraproject.org"
        ]
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "codemode": false,
        "headers": {
          "Authorization": "Bearer {file:/run/secrets/github-token}"
        }
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/run/secrets/*", "effect": "deny" },
    { "action": "external_directory", "resource": "/run/gitea-secrets/*", "effect": "deny" },
    { "action": "external_directory", "resource": "/opt/opencode-config/*", "effect": "deny" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "~/.config/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/opencode/skills/*", "effect": "allow" },
    { "action": "read", "resource": "~/.config/opencode/commands/*", "effect": "allow" },
    { "action": "read", "resource": "~/.config/opencode/agents/*", "effect": "allow" },
    { "action": "read", "resource": "/opt/opencode-config/*", "effect": "deny" },
    { "action": "read", "resource": "/run/secrets/*", "effect": "deny" },
    { "action": "read", "resource": "/run/gitea-secrets/*", "effect": "deny" },

    { "action": "edit", "resource": "~/.config/opencode/skills/*", "effect": "allow" },
    { "action": "edit", "resource": "~/.config/opencode/commands/*", "effect": "allow" },
    { "action": "edit", "resource": "~/.config/opencode/agents/*", "effect": "allow" },

    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "env *", "effect": "deny" },
    { "action": "shell", "resource": "printenv", "effect": "deny" },
    { "action": "shell", "resource": "printenv *", "effect": "deny" },

    { "action": "skill", "resource": "*", "effect": "allow" }
  ]
}
