{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "mcp": {
    "gitea-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "gitea-mcp",
        "-t", "stdio",
        "-H", "https://forge.fedoraproject.org"
      ]
    },
    "github": {
      "enabled": true,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:/run/secrets/github-token}"
      }
    }
  },
  "plugin": [["webfetch-ua", { "userAgent": "FedoraAgent/1.0" }]],
  "permission": {
    "external_directory": {
      "/tmp/*": "allow"
    },
    "edit": {
      "~/.config/opencode/skills/*": "allow",
      "~/.config/opencode/commands/*": "allow",
      "~/.config/opencode/agents/*": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.config/*": "deny",
      "~/.config/opencode/opencode.json": "deny",
      "~/.config/opencode/AGENTS.md": "deny",
      "~/.config/opencode/skills/*": "allow",
      "~/.config/opencode/commands/*": "allow",
      "~/.config/opencode/agents/*": "allow",
      "/opt/opencode-config/*": "deny",
      "/run/secrets/*": "deny",
      "/run/gitea-secrets/*": "deny"
    },
    "bash": {
      "env": "deny",
      "env *": "deny",
      "printenv": "deny",
      "printenv *": "deny"
    },
    "skill": {
      "*": "allow"
    }
  }
}
